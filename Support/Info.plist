<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>NotchApp</string>
    <key>CFBundleDisplayName</key>
    <string>NotchApp</string>
    <key>CFBundleIdentifier</key>
    <string>com.local.NotchApp</string>
    <key>CFBundleExecutable</key>
    <string>NotchApp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu bar app: no Dock icon, no app menu -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown when NotchApp first asks to control a browser (to switch to the playing tab) -->
    <key>NSAppleEventsUsageDescription</key>
    <string>NotchApp switches to the browser tab that is playing media when you click it in the notch.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
